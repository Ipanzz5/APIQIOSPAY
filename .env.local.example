# ================================================================
# QRIS Deposit API — Environment Variables
# Salin file ini ke .env.local lalu isi nilainya
# JANGAN pernah commit .env.local yang sudah terisi.
# ================================================================

# === DATABASE (wajib) ===
# Daftar gratis di https://neon.tech, copy connection string (versi pooled)
DATABASE_URL=

# === API PRODUK & QRIS (opsional, multi-tenant jika tidak diisi) ===
# Merchant default untuk API produk/kategori jika caller tidak menyertakan sendiri
# QIOSPAY_MERCHANT_CODE=
# QIOSPAY_API_KEY=

# === H2H (Host-to-Host) PPOB — kredensial default ===
# Bisa di-override per request dengan parameter memberID, pin, password
# QIOSPAY_MEMBER_ID=
# QIOSPAY_PIN=
# QIOSPAY_PASSWORD=

# === KEAMANAN API (wajib) ===
# Token buatan sendiri untuk proteksi endpoint. Generate: openssl rand -hex 32
# Token ini BUKAN milik Qiospay — bebas kamu tentukan sendiri.
API_BEARER_TOKEN=

# === CATATAN PENTING ===
# MERCHANT_CODE, API_KEY, dan QRIS_STATIC Qiospay TIDAK diisi di sini.
# API ini bersifat PUBLIK MULTI-TENANT: setiap pemanggil menyertakan
# kredensial Qiospay miliknya sendiri langsung di body/query request.
# Lihat README.md bagian "Cara Penggunaan" untuk detail lengkap.

# === IMAGE HOSTING FALLBACK ===
# Pixhost tidak butuh konfigurasi (otomatis aktif, dipakai pertama kali).
# Isi Cloudinary sebagai fallback kedua jika Pixhost gagal.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === SCHEDULER FALLBACK (opsional, hanya Railway/VPS/Docker) ===
# Di Vercel tidak perlu diaktifkan (gunakan callback webhook saja).
ENABLE_INTERNAL_SCHEDULER=false
SCHEDULER_CRON=*/30 * * * * *
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# === MONITORING (opsional) ===
SENTRY_DSN=
